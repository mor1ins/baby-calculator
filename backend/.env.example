# Export before launching; .env is not loaded implicitly.
# Allowed values: local, dev, prod, test
BABY_ENVIRONMENT=local
# Exact browser origin used for CSRF validation.
BABY_PUBLIC_ORIGIN=http://localhost:8080
# PostgreSQL through psycopg; use your own credentials outside disposable tests.
# URL-encode special characters in username/password.
BABY_DATABASE_URL=postgresql+psycopg://baby:CHANGE_ME@127.0.0.1:5432/baby
# Overall readiness timeout in seconds (0.1..30).
BABY_DATABASE_TIMEOUT=2
