FROM node:24-alpine AS build
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
COPY design/styles.css design/refinement.css design/components.css /design/
COPY design/fonts /design/fonts
RUN npm run build
FROM nginx:1.28-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --chmod=755 deploy/frontend-config.sh /docker-entrypoint.d/40-baby-config.sh
EXPOSE 80
