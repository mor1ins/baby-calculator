FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.9.26 /uv /usr/local/bin/uv
WORKDIR /app/backend
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --locked --no-dev
COPY backend/ ./
COPY api/ /app/api/
COPY deploy/create_admin.py ./create_admin.py
RUN useradd --uid 10001 --create-home baby
USER baby
EXPOSE 8000
CMD ["uv", "run", "--locked", "--no-dev", "uvicorn", "service.bootstrap:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
