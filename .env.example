# Local prototype only. PostgreSQL is not exposed to the host.
APP_PORT=8080
# For smartphone access, set your computer's LAN IP in both values.
APP_BIND_ADDRESS=127.0.0.1
APP_ORIGIN=http://localhost:8080
POSTGRES_PASSWORD=baby_local_only

# Allowed clock lead in minutes (exclusive); 0 disables tolerance.
BABY_CLOCK_SKEW_TOLERANCE_MINUTES=20

# Public registration: both switches are required to enable it.
BABY_REGISTRATION_ENABLED=false
FRONTEND_REGISTRATION_ENABLED=false
